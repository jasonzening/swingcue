# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# fal API testing outputs (one-shot, sensitive)
fal_result.json
inspected.png
mesh.glb
test_finish.png
test_swing.mp4*
*.glb

# Claude Code local config
.claude/

# python
__pycache__/
*.pyc

# ONNX model exports — generated by the Docker yolo-builder stage at
# build time (see python/Dockerfile). Same convention as the .pt weights,
# which are also never committed.
*.onnx
tmp/

# PR-6.0 benchmark harness — local-only test videos + runner outputs.
# Never committed; runners regenerate everything from source videos.
python/benchmark/test_videos/
python/benchmark/output/
.venv-benchmark/

# Phase 1C — local-only doc zip + extracted spec working copies
docs/files.zip
docs/files/
