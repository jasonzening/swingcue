# =============================================================================
# SwingCue — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.
# =============================================================================

# Supabase project URL — found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — NEVER expose to the browser.
# Used only in server-side API routes for privileged write operations.
SUPABASE_SERVICE_ROLE_KEY=

# === Admin / Internal Tools ===
# Comma-separated list of auth.users.id UUIDs allowed to access /admin/* routes.
# These users can use the landmark annotation workbench (PR-7A) and any
# future internal-only surfaces. NOT a substitute for proper role-based
# access — fine for pre-launch with 1-3 admins.
# Example:
#   ADMIN_USER_IDS=11111111-1111-1111-1111-111111111111,22222222-...
ADMIN_USER_IDS=
